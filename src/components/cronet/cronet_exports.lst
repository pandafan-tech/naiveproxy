# Linker script that exports only Cronet public API symbols.
# Used for Linux shared library builds to control symbol visibility.
{
  global:
    Cronet_*;
    bidirectional_stream_*;
    SSL_set_reality_global_config;
    SSL_set_reality_global_config_for_server_name;
  local:
    *;
};
